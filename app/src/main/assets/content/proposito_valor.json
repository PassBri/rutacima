    {
     "type": "prompt",
     "id": "proposito_valor.q3",
     "label": "¿Cuál de estas experiencias podría ayudar a otros?"
    },
    {
     "type": "heading",
     "level": 2,
     "text": "CATEGORÍA 3: Acceso y Conexiones"
    },
    {
     "type": "paragraph",
     "text": "Tus conexiones y accesos tienen valor."
    },
    {
     "type": "prompt",
     "id": "proposito_valor.q4",
     "label": "¿A qué personas, comunidades, o espacios tienes acceso que otros no tienen?"
